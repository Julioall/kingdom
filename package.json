{
  "name": "kingdom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit:food": "node scripts/audit-food-replays.mjs",
    "audit:livestock": "node scripts/audit-livestock-scenario.mjs",
    "audit:social": "node scripts/audit-social-baseline.mjs",
    "dev": "node scripts/run-local.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/optimize-images.mjs",
    "preview": "node scripts/run-local.mjs --preview",
    "ai:prepare": "node scripts/prepare-ai-models.mjs",
    "ai:serve": "node src/ai/ollama-service.mjs",
    "typecheck": "tsc --noEmit",
    "bench:simulation": "node scripts/benchmark-simulation.mjs",
    "verify:images": "node scripts/verify-build-images.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

