        "effect_building_destroy_01"
      ]
    },
    "character_body_impact": {
      "when": "on_melee_body_hit_to_unarmored_pawn",
      "pick": "fixed",
      "ids": [
        "effect_character_body_impact_01"
      ]
    },
    "arrow_wood_impact": {
      "when": "on_arrow_hit_to_unarmored_target",
      "pick": "fixed",
      "ids": [
        "effect_arrow_wood_impact_01"
      ]
    },
    "crossbow_fire": {
      "when": "on_arrow_hit_to_armored_military_target_per_design_mapping",
      "pick": "fixed",
      "ids": [
        "effect_crossbow_fire_01"
      ]
    },
    "hammer_build": {
      "when": "on_successful_pawn_build_activity",
      "pick": "random_one",
      "ids": [
        "effect_hammer_build_01",
        "effect_hammer_build_02"
      ]
    },
    "mining": {
      "when": "on_successful_mining_activity",
