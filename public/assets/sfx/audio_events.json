  "usage": {
    "wind_ambience": {
      "when": "after_audio_unlock",
      "pick": "continuous_loop",
      "zoom_gain": "50% de zoom: 70%; 1600% de zoom: 10%; transição suave e controle de volume geral.",
      "ids": ["effect_wind_ambience_01"]
    },
    "building_destroyed": {
      "when": "on_building_destroyed",
      "pick": "random_one",
      "cooldown_rule": "one_shot_per_building_death",
      "ids": [
        "effect_building_destroy_01",
        "effect_building_destroy_02",
        "effect_building_destroy_03",
        "effect_building_destroy_04"
      ]
    },
    "war_call": {
      "when": "on_war_call",
      "pick": "fixed",
      "ids": [
        "effect_war_horn_call_01"
      ]
    },
    "retreat_ordered": {
